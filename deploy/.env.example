# ==============================================================================
# ThreadFlow ERP - Environment Variables Template
# Copy to `.env` before running `docker compose up -d`
# ==============================================================================

# --- PostgreSQL 16 Enterprise Database ---
POSTGRES_DB=threadflow_db
POSTGRES_USER=threadflow_admin
POSTGRES_PASSWORD=ThreadFlowDevSecure2026!
POSTGRES_PORT=5432

# --- Redis 7.2 Cache & Lock ---
REDIS_PASSWORD=RedisDevSecure2026!
REDIS_PORT=6379

# --- Keycloak 24 Identity Provider ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=KeycloakAdmin2026!
KEYCLOAK_PORT=8080

# --- MinIO S3 Object Storage ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=MinioAdmin2026!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit Mock SMTP ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application Hosts ---
BACKEND_PORT=5000
FRONTEND_PORT=3000
