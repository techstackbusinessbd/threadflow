# ==============================================================================
# ThreadFlow ERP - Frontend Development Dockerfile (Node.js 22 Alpine)
# Enables containerized live development with Vite HMR hot reloading
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

EXPOSE 3000

ENV HOST=0.0.0.0
ENV PORT=3000

# Bootstrap packages if missing and start Vite dev server
CMD ["sh", "-c", "if [ ! -d node_modules ]; then npm install; fi && npm run dev -- --host 0.0.0.0 --port 3000"]
